* text=auto

.gitattributes text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.stderr text eol=lf
*.rules text eol=lf
*.ps1 text eol=lf
Cargo.lock text eol=lf
LICENSE-* text eol=lf
justfile text eol=lf

# Captured follow-up evidence keeps its original bytes on every platform.
dev_doc/reviews/2026_10_17_followup/evidence/**/*.log -text
dev_doc/reviews/2026_10_17_followup/evidence/**/*.patch -text

# These native logs end with the test runner's original blank line.
dev_doc/reviews/2026_10_17_followup/evidence/runtime/native/csv-after.log whitespace=-blank-at-eof
dev_doc/reviews/2026_10_17_followup/evidence/runtime/native/inspect-sites-after.log whitespace=-blank-at-eof
dev_doc/reviews/2026_10_17_followup/evidence/validation/macro-docs-tests.log whitespace=-blank-at-eof
dev_doc/reviews/2026_10_17_followup/evidence/validation/user-exercises-feature-gate.log whitespace=-blank-at-eof
