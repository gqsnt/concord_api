# Concord project-local Codex exec-policy rules for Zed ACP Full access.
#
# Full access uses approval_policy = "never" / AskForApproval = Never. A `prompt` decision would
# therefore fail instead of displaying a usable confirmation dialog. This file deliberately uses
# only `allow` and `forbidden`; the most restrictive matching rule wins.
#
# Full access removes the Codex sandbox, but it does not expand the approved mission. These rules
# retain hard stops for remote Git, history replacement, publication, external transfer, system
# mutation, broad staging, unsafe commit forms, and shell-level deletion.
# Restart Codex after changing this file because rules are loaded at session startup.

# Remote Git and repository substitution are outside the controller-verified local workflow.

# Git global options can redirect the command to another repository or inject configuration aliases,
# bypassing the verified repository and the subcommand rules below.
prefix_rule(
    pattern = ["git", ["-C", "-c", "--config-env", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--bare"]],
    decision = "forbidden",
    justification = "Run Git from the verified repository root without repository redirection, injected configuration, aliases, or alternate object/worktree locations.",
    match = [
        "git -C ../other status",
        "git -c alias.ship=push ship",
        "git --config-env http.extraHeader=TOKEN status",
        "git --git-dir ../other/.git status",
        "git --work-tree ../other status",
        "git --namespace alternate status",
        "git --exec-path /tmp/helpers status",
        "git --bare status",
    ],
)

prefix_rule(
    pattern = ["git", ["push", "pull", "fetch", "clone", "ls-remote"]],
    decision = "forbidden",
    justification = "Remote Git is not authorized. Keep the verified local checkout and produce local commits and patches only.",
    match = [
        "git push origin master",
        "git pull --rebase",
        "git fetch origin",
        "git clone https://example.invalid/repo",
        "git ls-remote origin",
    ],
)

# History, branch, index-hiding, and worktree replacement operations are prohibited.
prefix_rule(
    pattern = ["git", ["merge", "rebase", "reset", "clean", "restore", "stash", "switch", "checkout", "cherry-pick", "revert"]],
    decision = "forbidden",
    justification = "Do not rewrite, replace, hide, or cross the controller-verified workspace state. Stop and re-bootstrap instead.",
    match = [
        "git merge topic",
        "git rebase master",
        "git reset --hard HEAD~1",
        "git clean -fd",
        "git restore .",
        "git stash",
        "git switch topic",
        "git checkout topic",
        "git cherry-pick deadbeef",
        "git revert deadbeef",
    ],
)

prefix_rule(
    pattern = ["git", ["remote", "tag", "worktree"]],
    decision = "forbidden",
    justification = "Remote configuration, tags, and alternate worktrees require a separate explicit user authorization.",
    match = [
        "git remote add origin https://example.invalid/repo",
        "git tag v0.1.0",
        "git worktree add ../tmp",
    ],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D", "--delete"]],
    decision = "forbidden",
    justification = "Branch deletion is destructive and unrelated to a phase mission.",
    match = ["git branch -D topic", "git branch --delete topic"],
)

# Broad staging defeats exact-path review. More restrictive rules win over the generic allow rule.
prefix_rule(
    pattern = ["git", "add", [".", "-A", "--all", "-u", "--update", ":/"]],
    decision = "forbidden",
    justification = "Stage exact reviewed paths with `git add -- <path> ...`; broad repository staging is not allowed.",
    match = [
        "git add .",
        "git add -A",
        "git add --all",
        "git add -u",
        "git add --update",
        "git add :/",
    ],
    not_match = ["git add -- concord_core/src/lib.rs"],
)

prefix_rule(
    pattern = ["git", "add", "--", [".", ":/"]],
    decision = "forbidden",
    justification = "Stage exact reviewed paths after `--`; do not stage the whole repository.",
    match = ["git add -- .", "git add -- :/"],
    not_match = ["git add -- docs/conformance/PHASE_5_REPORT.md"],
)

# Exact-path staging and focused local commits are permitted without an approval prompt. Broad
# staging and unsafe commit forms remain forbidden by the more specific rules above and below.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow exact reviewed mission paths to be staged without an ACP approval prompt.",
    match = [
        "git add -- concord_core/src/lib.rs",
        "git add -- docs/conformance/PHASE_5_REPORT.md",
    ],
)

# Commit forms that implicitly stage, rewrite history, bypass verification, or reuse another commit
# message are outside the phase workflow.
prefix_rule(
    pattern = ["git", "commit", ["-a", "--all", "-am", "--amend", "--no-verify", "--fixup", "--squash", "-C", "-c", "--reuse-message", "--reedit-message"]],
    decision = "forbidden",
    justification = "Use a new focused `git commit -m <message>` after exact-path staging and staged-diff review; do not implicitly stage, amend, or bypass checks.",
    match = [
        "git commit -a",
        "git commit -am update",
        "git commit --amend",
        "git commit --no-verify -m update",
        "git commit --fixup deadbeef",
        "git commit -C deadbeef",
    ],
    not_match = ["git commit -m feat: implement approved phase outcome"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow a focused new local commit without an ACP approval prompt after staged-diff review.",
    match = ["git commit -m feat: implement approved phase outcome"],
)

prefix_rule(
    pattern = ["git", ["mv", "rm"]],
    decision = "allow",
    justification = "Allow mission-scoped tracked moves and removals without an ACP approval prompt; preserve pre-existing user work.",
    match = ["git mv old.rs new.rs", "git rm obsolete.rs"],
)

# Publication, hosted-repository operations, deployment, and direct network/file-transfer tools are
# not required for local Concord implementation.
prefix_rule(
    pattern = ["cargo", ["publish", "login", "logout", "owner", "yank"]],
    decision = "forbidden",
    justification = "Publishing, registry credentials, ownership changes, and release administration are outside an implementation mission.",
    match = [
        "cargo publish",
        "cargo publish --dry-run",
        "cargo login token",
        "cargo logout",
        "cargo owner --add user crate",
        "cargo yank --version 0.1.0 crate",
    ],
)

prefix_rule(
    pattern = [["gh", "glab"]],
    decision = "forbidden",
    justification = "Hosted-repository operations are outside the local phase workflow. Report the required action instead.",
    match = ["gh pr create", "gh release create v0.1.0", "glab mr create"],
)

prefix_rule(
    pattern = [["curl", "wget", "ssh", "scp", "sftp", "rsync"]],
    decision = "forbidden",
    justification = "External network and file-transfer tools are not authorized. Use committed repository inputs or report the dependency unavailable.",
    match = [
        "curl https://example.com",
        "wget https://example.com/file",
        "ssh host",
        "scp file host:/tmp",
    ],
)

prefix_rule(
    pattern = [["Invoke-WebRequest", "iwr", "Invoke-RestMethod", "irm"]],
    decision = "forbidden",
    justification = "PowerShell network access is not authorized for Concord phase work.",
    match = ["Invoke-WebRequest https://example.com", "irm https://example.com"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "System-level changes are outside the repository mission. Report the missing tool or environment requirement.",
    match = ["sudo apt install cargo-nextest"],
)

# Dependency graph changes are allowed only when the approved mission requires them. The agent must
# review manifest and lockfile changes. Tool installation and toolchain mutation remain forbidden.
prefix_rule(
    pattern = ["cargo", ["add", "update"]],
    decision = "allow",
    justification = "Allow approved dependency changes without an ACP approval prompt; inspect manifest and lockfile changes and preserve the pinned policy.",
    match = ["cargo add example", "cargo update -p bytes"],
)

prefix_rule(
    pattern = ["cargo", "install"],
    decision = "forbidden",
    justification = "Do not install tools from an implementation session. Report the missing maintained tool for manual provisioning.",
    match = ["cargo install cargo-nextest"],
)

prefix_rule(
    pattern = ["rustup"],
    decision = "forbidden",
    justification = "Use the repository-pinned, pre-provisioned Rust toolchain. Report missing components instead of mutating the toolchain.",
    match = ["rustup toolchain install 1.85.0", "rustup component add clippy"],
)

# Shell-level removal is blocked. Use reviewed `git rm` for tracked mission files or an editor patch
# for source changes so removals remain visible in the Git diff.
prefix_rule(
    pattern = [["rm", "rmdir", "unlink", "shred", "Remove-Item", "ri", "del", "erase"]],
    decision = "forbidden",
    justification = "Use reviewed `git rm` for tracked mission files or an editor patch; do not perform opaque shell-level deletion in a full-access session.",
    match = [
        "rm obsolete.rs",
        "rmdir empty-directory",
        "unlink generated-link",
        "Remove-Item obsolete.rs",
        "del obsolete.rs",
    ],
)
