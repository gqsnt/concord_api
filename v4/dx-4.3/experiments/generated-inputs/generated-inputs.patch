+//! SDK version 3: `limit` becomes optional and initially present (`limit?: u32 = 20`) so that a
+//! caller can omit it. Compatible for setter callers (`set_limit(5)` still compiles); the input
+//! field's type changes from `u32` to `Option<u32>`.
+concord::api! {
+    pub client Shop(#[sensitive] header("x-api-key") key: String) {
+        base "https://shop.example.test/v1";
+        scope listing(query("tag") each default_tags: Vec<String> = Vec::new()) {
+            GET list(
+                query q?: String,
+                tags?: Vec<String>,
+                query limit?: u32 = 20,
+                query sort?: String,
+            ) {
+                path "items";
+                query { override "tag" = each tags else inherit; }
+            }
+        }
+    }
+}
diff --git a/v4/dx-4.3/experiments/generated-inputs/ra_probe.py b/v4/dx-4.3/experiments/generated-inputs/ra_probe.py
new file mode 100644
index 0000000..b69e154
--- /dev/null
+++ b/v4/dx-4.3/experiments/generated-inputs/ra_probe.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""DX04 probe: asks rust-analyzer (the pinned toolchain's) for hover, go-to-definition and
+completion at fixed places in the saved evolution consumers, and prints what it answered.
+
+Usage: python3 -I ra_probe.py [--toolchain 1.99.1]   (run after evolution/run.sh restored v1)
+
+It records observations; it does not judge them. Positions are found by searching the source
+text, so the probe follows the files if they move.
+"""
+
+import json
+import os
+import subprocess
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.join(HERE, "evolution")
+TOOLCHAIN = sys.argv[sys.argv.index("--toolchain") + 1] if "--toolchain" in sys.argv else "1.99.1"
+
+
+class Lsp:
+    def __init__(self):
+        self.p = subprocess.Popen(
+            ["rustup", "run", TOOLCHAIN, "rust-analyzer"],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, cwd=ROOT)
+        self.next_id = 0
+
+    def send(self, msg):
+        body = json.dumps(msg).encode()
