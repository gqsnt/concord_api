+//! Long native chains: suppression, cached classification, cadence and check ordering.
+use concord::{CodecError, Encode, reqwest};
+use reqwest::header::HeaderName;
+use std::fmt;
+use std::sync::atomic::{AtomicUsize, Ordering::SeqCst};
+const KEY: HeaderName = HeaderName::from_static("x-o01-live");
+const HOST: HeaderName = reqwest::header::HOST;
+static INIT: AtomicUsize = AtomicUsize::new(0);
+static FORMATTED: AtomicUsize = AtomicUsize::new(0);
+/// A formatter that records calls and refuses conversion.
+#[derive(Clone)]
+pub struct Bad;
+impl fmt::Display for Bad {
+    fn fmt(&self, _: &mut fmt::Formatter<'_>) -> fmt::Result {
+        FORMATTED.fetch_add(1, SeqCst);
+        Err(fmt::Error)
+    }
+}
+fn initial() -> Bad {
+    INIT.fetch_add(1, SeqCst);
+    Bad
+}
+/// An encoder that records the earlier body failure by its static diagnostic.
+pub struct Refuse;
+impl Encode<String> for Refuse {
+    const CONTENT_TYPE: Option<&'static str> = None;
+    fn encode(_: String) -> Result<reqwest::Body, CodecError> {
+        Err(CodecError::new("O01 body first"))
+    }
+}
+concord::api! {
+    pub client Ordered(#[sensitive] bad:Bad=initial(), header(reqwest::header::AUTHORIZATION) auth:reqwest::header::HeaderValue = reqwest::header::HeaderValue::from_static("dummy")) {
+        base "http://127.0.0.1/o01";
+        headers {
+            KEY="{bad}";
+            "x-f0"="v"; "x-f1"="v"; "x-f2"="v"; "x-f3"="v";
+            "x-f4"="v"; "x-f5"="v"; "x-f6"="v"; "x-f7"="v";
+            "x-f8"="v"; "x-f9"="v"; "x-f10"="v"; "x-f11"="v";
+            "x-f12"="v"; "x-f13"="v"; "x-f14"="v"; "x-f15"="v";
+        }
+        GET cleared(v:Option<&'static str> = None) {headers {override KEY=each v;}}
+        GET inherited(v?:&'static str) {headers {override KEY=v else inherit;}}
+        GET replaced(header(KEY) v:&'static str="replacement") {headers {remove KEY;}}
+        GET structural() {headers {HOST="bad";}}
+        POST body_first(body b:String) {request Refuse; headers {HOST="bad";}}
+        GET path_first(p:Bad) {path "{p}";headers {HOST="bad";}}
+        GET query_first(query q:Bad) {headers {HOST="bad";}}
+    }
+}
+#[test]
+fn long_chain_preserves_suppression_cadence_classification_and_order() {
+    let check = Ordered::validate_header_names().unwrap_err();
+    assert_eq!(INIT.load(SeqCst), 0);
+    assert_eq!(FORMATTED.load(SeqCst), 0);
+    assert_eq!(check.problems().len(), 4);
+    let api = Ordered::new(reqwest::Client::builder().no_proxy().build().unwrap());
+    assert_eq!(INIT.load(SeqCst), 1);
+    for _ in 0..3 {
+        let p = api.cleared().prepare().unwrap();
+        assert!(!p.request().headers().contains_key(KEY));
+        assert_eq!(
+            p.request().headers()[reqwest::header::AUTHORIZATION],
+            "dummy"
+        );
+        assert!(p.request().headers()[reqwest::header::AUTHORIZATION].is_sensitive());
+        let p = api.replaced().prepare().unwrap();
+        assert_eq!(p.request().headers()[KEY], "replacement");
+        assert!(p.request().headers()[KEY].is_sensitive());
+        assert_eq!(FORMATTED.load(SeqCst), 0);
+    }
+    let error = api.structural().prepare().unwrap_err().to_string();
+    assert!(error.contains("reqwest/hyper manage"), "{error}");
+    assert_eq!(FORMATTED.load(SeqCst), 0);
+    let error = api.body_first("dummy").prepare().unwrap_err().to_string();
+    assert!(error.contains("O01 body first"), "{error}");
+    assert_eq!(FORMATTED.load(SeqCst), 0);
+    let error = api.path_first(Bad).prepare().unwrap_err().to_string();
+    assert!(error.contains("path"), "{error}");
+    assert_eq!(FORMATTED.load(SeqCst), 1);
+    let error = api.query_first(Bad).prepare().unwrap_err().to_string();
+    assert!(error.contains("query"), "{error}");
+    assert_eq!(FORMATTED.load(SeqCst), 2);
+    let error = api.inherited().prepare().unwrap_err().to_string();
+    assert!(error.contains("header"), "{error}");
+    assert_eq!(FORMATTED.load(SeqCst), 3);
+    assert_eq!(INIT.load(SeqCst), 1);
+}
