# Run the complete gate by default. All cargo work is offline.
default: gate

# Override with PROPTEST_CASES=4096 just props. Each property defaults to 256 cases.
prop_cases := env_var_or_default("PROPTEST_CASES", "256")

[no-exit-message]
props:
    @PROPTEST_CASES={{prop_cases}} CARGO_TARGET_DIR="$PWD/target" cargo test --offline -p concord-core -p concord-extras --all-features --test 'prop_*'

[no-exit-message]
fmt:
    @python3 -B tools/gate.py fmt

[no-exit-message]
check:
    @python3 -B tools/gate.py check

[no-exit-message]
lint:
    @python3 -B tools/gate.py lint

[no-exit-message]
test:
    @python3 -B tools/gate.py test

[no-exit-message]
doc:
    @python3 -B tools/gate.py doc

[no-exit-message]
msrv:
    @python3 -B tools/gate.py msrv

[no-exit-message]
features:
    @python3 -B tools/gate.py features

[no-exit-message]
todo:
    @python3 -B tools/gate.py todo

[no-exit-message]
matrix:
    @python3 -B tools/matrix.py

[no-exit-message]
gate: props
    @python3 -B tools/gate.py gate

# Slow mutation gate; deliberately separate from gate.
[no-exit-message]
mutants *args:
    @python3 -B tools/mutate.py {{args}}

# Opt-in measurements; the counting allocator lives only in these bench binaries.
[no-exit-message]
bench *args:
    @python3 -B tools/limited.py python3 -B tools/bench.py {{args}}

# Feature-independent production safety inventory; new sites need a local reason.
[no-exit-message]
panics:
    @python3 -B tools/limited.py python3 -B tools/panics.py --list --compiler

# Full isolated matrix, including the 1.96 toolchain.
[no-exit-message]
features-all:
    @python3 -B tools/limited.py python3 -B tools/features.py

[no-exit-message]
docs-audit:
    @python3 -B tools/limited.py python3 -B tools/docs.py

# Each published crate as a stranger receives it: what its package holds, and that it builds alone.
[no-exit-message]
package:
    @../build/limited.sh python3 -B tools/package.py

# Run only after capturing actual PermissionDenied failures in target/m5-tests.log.
[no-exit-message]
test-sandbox:
    @python3 -B tools/limited.py python3 -B tools/sandbox_tests.py

# Complete release checks; --with-sockets also enables the socket mutant.
[no-exit-message]
release *args:
    @../build/limited.sh python3 -B tools/limited.py python3 -B tools/release.py {{args}}
