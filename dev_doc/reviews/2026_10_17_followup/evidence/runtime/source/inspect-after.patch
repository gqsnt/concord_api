 // A second, independently expanded copy of the baseline.
 shop!(baseline_copy);
 
+// Repeating the same representation default at a scope changes provenance
+// for that scope, while the client's other Json uses stay unchanged.
+shop!(
+    scope_json_default,
+    admin = {
+        response Json;
+        rate_limit reads(tenant = client.tenant);
+
+        GET stats() -> Stats {
+            id "shop.admin.stats";
+            path "stats";
+        }
+
+        GET audit() -> Stats {
+            id "shop.admin.audit";
+            path "audit";
+        }
+    }
+);
+
+// Selecting the same representation inline adds one dependency site, so a
+// diff from scope_json_default replaces a site without changing its count.
+shop!(
+    inline_json_default,
+    endpoints = {
+        GET item(id: String) -> Label via VendorJson {
+            id "shop.item";
+            path "items/{id}";
+        }
+
+        PUT update(id: String, body input: Update) -> Stats via Json {
+            id "shop.update";
+            path "items/{id}";
+            auth replace { header "X-Key" = partner; }
+            effect idempotent;
+            rate_limit {
+                id "shop.write";
+                key [origin, endpoint, "tenant" = client.tenant];
+                cost 2;
+                allow 5 per 1s;
+            }
+        }
+
+        GET ping() -> Stats via Json {
+            path "ping";
+        }
+    }
+);
+
 // Credential selection: the client placement names another credential at the
