@@ -590,6 +639,58 @@ fn located(report: &DiffReport, axis: Axis) -> Vec<String> {
 
 // ----- tests --------------------------------------------------------------------
 
+fn assert_dependency_sites_endpoints(
+    before: &ContractDescription,
+    after: &ContractDescription,
+    expected: &[&str],
+) {
+    let expected = expected
+        .iter()
+        .map(|id| (*id).to_owned())
+        .collect::<BTreeSet<_>>();
+    for (before, after) in [(before, after), (after, before)] {
+        let report = diff(before, after);
+        assert_eq!(report.axes(), BTreeSet::from([Axis::Provenance]));
+        assert_eq!(endpoint_ids(&report), expected, "{}", report.to_text());
+        let changes = report
+            .changes()
+            .iter()
+            .filter(|change| change.collection() == "dependencies")
+            .collect::<Vec<_>>();
+        assert!(!changes.is_empty(), "the dependency's sites changed");
+        for change in changes {
+            assert!(change.field().starts_with("sites"));
+            assert_eq!(
+                change
+                    .endpoints()
+                    .iter()
+                    .map(|endpoint| endpoint.id().to_owned())
+                    .collect::<BTreeSet<_>>(),
+                expected,
+                "unchanged sites must not broaden the affected endpoints"
+            );
+        }
+    }
+}
+
+#[test]
+fn generated_dependency_sites_add_remove_names_only_scope_endpoints() {
+    assert_dependency_sites_endpoints(
+        baseline::Shop::contract(),
+        scope_json_default::Shop::contract(),
+        &["shop.admin.audit", "shop.admin.stats"],
+    );
+}
+
+#[test]
+fn generated_dependency_sites_replace_names_only_changed_consumers() {
+    assert_dependency_sites_endpoints(
+        scope_json_default::Shop::contract(),
+        inline_json_default::Shop::contract(),
+        &["shop.admin.audit", "shop.admin.stats", "shop.ping"],
+    );
+}
